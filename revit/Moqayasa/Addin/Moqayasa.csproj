<Project Sdk="Microsoft.NET.Sdk">
  <!-- One source tree, one build per Revit year:  dotnet build Addin -c Release -p:RevitYear=2024
       2022-2024 -> .NET Framework 4.8 ; 2025-2026 -> .NET 8 ; 2027 -> .NET 10 -->
  <PropertyGroup>
    <RevitYear Condition="'$(RevitYear)' == ''">2026</RevitYear>
    <TargetFramework Condition="$(RevitYear) &lt;= 2024">net48</TargetFramework>
    <TargetFramework Condition="$(RevitYear) &gt;= 2025 And $(RevitYear) &lt;= 2026">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitYear) &gt;= 2027">net10.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT$(RevitYear)</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Moqayasa</AssemblyName>
    <RootNamespace>Moqayasa</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>bin\$(Configuration)\R$(RevitYear)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitYear).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitYear).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="..\Core\Moqayasa.Core.csproj" />
    <Content Include="..\..\..\hasr\price_sources_example.json" Link="price_sources_example.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\hasr\systems_example.json" Link="systems_example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'"><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies></PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
  </ItemGroup>
</Project>
